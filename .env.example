# ─── Backend environment (copy to `.env` on each machine) ────────────────────
# IMPORTANT: `.env` is NOT part of the deployment pipeline. The GitHub Actions
# workflow deploys only `dist/`, `package.json` and `package-lock.json`. The
# `.env` file must be created ONCE, directly on the production server
# (~/html/blueplug-backend/.env), and must never be copied/regenerated by the
# deploy. The server code fails fast at startup when JWT_SECRET is missing in
# production.

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:8080

# ─── Database (MySQL) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=blueplug
DB_PASS=change-me
DB_NAME=ecs0
DB_PORT=3307

# ─── Crypto (AES-256-CBC) ─────────────────────────────
ENCRYPTION_KEY=replace-with-a-32-hex-char-key

# ─── JWT Auth ─────────────────────────────────────────
# Set this ONCE to a long random value and never change it. Changing it (or
# leaving it unset so the server falls back to a default) invalidates every
# stored session, including the 30-day "remember me" tokens, on restart.
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h

# ─── Admin Credentials ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── Content Security Policy ──────────────────────────
CSP_CONNECT_SRC=http://localhost:5173 http://localhost:3001 http://localhost:8080

# ─── Legacy PHP Sync Script (server only) ─────────────
PHP_SCRIPT_PATH=/var/www/html/apiTestUpdate.php